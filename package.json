{
  "name": "mia",
  "version": "0.1.0",
  "private": true,
  "description": "Mia: voice assistant for Omarchy. D1 slice: text client, server, one agent adapter.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "fixtures/*",
    "apps/*",
    "tools/*",
    "tests/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:acceptance": "vitest run --project acceptance",
    "probe": "tsx tools/probe/src/main.ts",
    "server": "tsx apps/server/src/main.ts",
    "client": "tsx apps/text-client/src/main.ts",
    "mia": "tsx apps/debug-cli/src/main.ts",
    "fixture": "tsx fixtures/controlled-mcp/src/main.ts",
    "live": "tsx tests/acceptance/promptfoo/run.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  }
}
